# 台股分析系統 — 選用環境變數
# 皆為選填；未設定金鑰時基本面資料使用 FinMind 匿名額度，失敗會明確回報，不以假資料替代。

# FinMind（提升 rate limit，不填仍可匿名使用）
# 申請：finmindtrade.com（免費帳號）
# FINMIND_TOKEN=
# Docker Compose 會傳入中台；本機有填 .env 時使用：
# uv run --env-file .env uvicorn backend.data_service.main:app --reload --port 8001

# Telegram 推播（Phase 6 才需要，先用 CSV 輸出）
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# Docker Compose: loopback by default; use 0.0.0.0 only for intentional remote access.
# BIND_ADDRESS=127.0.0.1
# PORT=3000
